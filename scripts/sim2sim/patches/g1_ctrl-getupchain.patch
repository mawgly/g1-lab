diff --git a/deploy/include/FSM/State_GetUpBlend.h b/deploy/include/FSM/State_GetUpBlend.h
new file mode 100644
index 0000000..9c67d5a
--- /dev/null
+++ b/deploy/include/FSM/State_GetUpBlend.h
@@ -0,0 +1,303 @@
+// sim2sim getupchain patch (humanoid_sim iteration 82, scripts/lab/probes/getup_chain.py --handover pd S ...): the PD
+// transition between the getting-up policy and the tracker. No policy runs: from the target lowcmd holds on entry (the
+// getting-up policy's last one) each motor goes to the tracker's hand-over frame (params/handover.yaml of policy_dir,
+// export_g1 --handover-frame) by getup_chain::Schedule over `seconds`, its gains the tracker's (policy_dir's
+// deploy.yaml stiffness / damping) times kp -> kp_to and kd -> kd_to; targets clipped as the tracker's deploy.yaml
+// clips its actions, the locked motors at default_joint_pos. The targets change once a policy step (step_dt of that
+// deploy.yaml), as in getup_chain.py; after the last step it goes to `next` (the tracker's RLBase state), whose entry
+// keeps this target until its first policy step (the policy-start patch). Passive once a joint is faster than its
+// max_joint_speed (one number or one per SDK motor), as the getup patch's RLBase check.
+// Iteration 89: with retry_angle or abort_angle (rad) in the config.yaml handover block of the state that hands over
+// to this one (GetUp), it goes back there instead of `next` when the pelvis gravity from the IMU (this FSM tick's
+// lowstate) lies more than retry_angle from the frame's once the steps are done, or more than abort_angle at any
+// moment: the tracker cannot get up from the back the PD can roll the robot onto (bridge, 6 of 9 chain failures,
+// 176-179 deg at the end). GetUp then starts afresh; its max_retries bounds how many of its entries by a return may
+// hand over again. Without the keys the state is the one before bit for bit.
+#pragma once
+
+#include <chrono>
+#include <cmath>
+#include <mutex>
+#include <stdexcept>
+#include "FSMState.h"
+#include "FSM/getup_chain.h"
+
+class State_GetUpBlend : public FSMState
+{
+public:
+    State_GetUpBlend(int state, std::string state_string)
+    : FSMState(state, state_string)
+    {
+        auto cfg = param::config["FSM"][state_string];
+        const auto next_name = cfg["next"].as<std::string>();
+        if (!FSMStringMap.right.count(next_name)) {
+            throw std::runtime_error(state_string + ": next state " + next_name + " is not among config.yaml's "
+                                     "enabled states (sim2sim getupchain patch)");
+        }
+        next_state = FSMStringMap.right.at(next_name);
+        const auto policy_dir = param::parser_policy_dir(cfg["policy_dir"].as<std::string>());
+        auto deploy = YAML::LoadFile((policy_dir / "params" / "deploy.yaml").string());
+        const auto ids = deploy["joint_ids_map"].as<std::vector<float>>();
+        const auto clip = deploy["actions"]["JointPositionAction"]["clip"].as<std::vector<std::vector<float>>>();
+        const auto home = deploy["default_joint_pos"].as<std::vector<float>>();
+        stiffness = deploy["stiffness"].as<std::vector<float>>();  // SDK order, as State_RLBase::enter takes them
+        damping = deploy["damping"].as<std::vector<float>>();
+        step_dt = deploy["step_dt"].as<float>();
+        motors = ids.size();
+        if (clip.size() != motors || home.size() != motors || stiffness.size() != motors || damping.size() != motors) {
+            throw std::runtime_error(state_string + ": " + (policy_dir / "params" / "deploy.yaml").string() +
+                                     " has not one clip, default_joint_pos, stiffness and damping per joint "
+                                     "(sim2sim getupchain patch)");
+        }
+        frame = getup_chain::load_frame(policy_dir);
+        if (frame.joints.size() != motors) {
+            throw std::runtime_error(state_string + ": handover.yaml has " + std::to_string(frame.joints.size()) +
+                                     " joint angles for " + std::to_string(motors) + " motors (sim2sim getupchain patch)");
+        }
+        low.assign(motors, 0.0f);
+        high.assign(motors, 0.0f);
+        goal.assign(motors, 0.0f);
+        std::vector<float> rest(motors, 0.0f);
+        for (size_t i = 0; i < motors; ++i) {  // policy order -> SDK motor
+            const auto motor = static_cast<size_t>(ids[i]);
+            low[motor] = clip[i][0];
+            high[motor] = clip[i][1];
+            rest[motor] = home[i];
+        }
+        goal = frame.joints;
+        for (int motor : frame.locked) {
+            goal[motor] = rest[motor];
+        }
+        locked.assign(motors, false);
+        for (int motor : frame.locked) {
+            locked[motor] = true;
+        }
+        home_q = rest;
+
+        const float seconds = cfg["seconds"].as<float>();
+        schedule.steps = std::max(1L, std::lround(seconds / step_dt));
+        const float ramp = cfg["ramp"].as<float>(0.7f);
+        const float arms = cfg["arms"] ? cfg["arms"].as<float>() : ramp;
+        const float legs = cfg["legs"].as<float>(0.0f);
+        const auto arm_joints = cfg["arm_joints"].as<std::vector<int>>(std::vector<int>{});
+        schedule.share.assign(motors, ramp);
+        schedule.late.assign(motors, legs / step_dt);
+        for (int motor : arm_joints) {
+            schedule.share[motor] = arms;
+            schedule.late[motor] = 0.0f;
+        }
+        schedule.kp = cfg["kp"].as<float>(1.0f);
+        schedule.kd = cfg["kd"].as<float>(1.0f);
+        schedule.kp_to = cfg["kp_to"].as<float>(schedule.kp);
+        schedule.kd_to = cfg["kd_to"].as<float>(schedule.kd);
+        if (!(ramp > 0.0f && ramp <= 1.0f && arms > 0.0f && arms <= 1.0f && legs >= 0.0f && schedule.kp > 0.0f &&
+              schedule.kd > 0.0f && schedule.kp_to > 0.0f && schedule.kd_to > 0.0f &&
+              legs < seconds * ramp)) {
+            throw std::runtime_error(state_string + ": config.yaml needs ramp and arms in (0, 1], 0 <= legs < ramp * "
+                                     "seconds, kp, kd, kp_to and kd_to above 0 (sim2sim getupchain patch)");
+        }
+        if (cfg["max_joint_speed"]) {
+            auto limits = cfg["max_joint_speed"];
+            if (limits.IsSequence()) {
+                max_joint_speed = limits.as<std::vector<float>>();
+            } else {
+                max_joint_speed.assign(motors, limits.as<float>());
+            }
+            if (max_joint_speed.size() != motors) {
+                throw std::runtime_error(state_string + ": config.yaml max_joint_speed has " +
+                                         std::to_string(max_joint_speed.size()) + " numbers for " +
+                                         std::to_string(motors) + " motors (sim2sim getupchain patch)");
+            }
+            this->registered_checks.emplace_back(
+                std::make_pair([this]()->bool{ return too_fast(); }, FSMStringMap.right.at("Passive")));
+        }
+        // iteration 89: the enabled state whose handover block hands over to this one, and its retry_angle /
+        // abort_angle; the way back is checked before finished(), on the same FSM tick
+        auto fsm = param::config["FSM"];
+        for (auto it = fsm.begin(); it != fsm.end(); ++it) {
+            const auto name = it->first.as<std::string>();
+            if (name == "_" || !it->second.IsMap() || !FSMStringMap.right.count(name)) {
+                continue;
+            }
+            auto h = it->second["handover"];
+            if (!h || !h.IsMap() || !h["to"] || h["to"].as<std::string>() != state_string) {
+                continue;
+            }
+            retry_angle = h["retry_angle"].as<float>(-1.0f);
+            abort_angle = h["abort_angle"].as<float>(-1.0f);
+            if ((h["retry_angle"] && !(retry_angle > 0.0f)) || (h["abort_angle"] && !(abort_angle > 0.0f))) {
+                throw std::runtime_error(name + ": config.yaml handover retry_angle and abort_angle must be above 0 "
+                                         "(sim2sim getupchain patch)");
+            }
+            if (retry_angle > 0.0f || abort_angle > 0.0f) {
+                back_on = true;
+                back_name = name;
+                back_state = FSMStringMap.right.at(name);
+            }
+            break;
+        }
+        if (back_on) {
+            this->registered_checks.emplace_back(std::make_pair([this]()->bool{ return back_due(); }, back_state));
+            // warn, not info: record_check.py requires every info line of the patch, this one is there only with the keys
+            spdlog::warn("{}: back to {} with the pelvis more than {:.1f} deg from the frame's at the end or {:.1f} deg "
+                         "at any moment (negative: off) (sim2sim getupchain patch)", state_string, back_name,
+                         retry_angle * kDegrees, abort_angle * kDegrees);
+        }
+        this->registered_checks.emplace_back(std::make_pair([this]()->bool{ return finished(); }, next_state));
+        spdlog::info("{}: PD from the last target to frame {} over {} policy steps (arms {:.2f}, others {:.2f} of "
+                     "them, the others {:.2f} s later), kp x{:.2f} -> x{:.2f}, kd x{:.2f} -> x{:.2f}, then {} "
+                     "(sim2sim getupchain patch)", state_string, frame.frame, schedule.steps, arms, ramp, legs,
+                     schedule.kp, schedule.kp_to, schedule.kd, schedule.kd_to, next_name);
+    }
+
+    void enter()
+    {
+        start.assign(motors, 0.0f);
+        for (size_t motor = 0; motor < motors; ++motor) {
+            auto & cmd = lowcmd->msg_.motor_cmd()[motor];
+            start[motor] = cmd.q();
+            cmd.dq() = 0;
+            cmd.tau() = 0;
+        }
+        entered_at = std::chrono::steady_clock::now();
+        last_step = 0;
+        reported = false;
+        tick_seconds = 0.0f;
+        tick_angle = 0.0f;
+        uint32_t tick;
+        {
+            std::lock_guard<std::mutex> lock(lowstate->mutex_);
+            tick = lowstate->msg_.tick();
+        }
+        spdlog::warn("{}: from the last target to frame {} over {} policy steps, from lowstate tick {} "
+                     "(sim2sim getupchain patch)", getStateString(), frame.frame, schedule.steps, tick);
+        apply(1);
+    }
+
+    void run()
+    {
+        const float seconds = std::chrono::duration<float>(std::chrono::steady_clock::now() - entered_at).count();
+        apply(std::min(schedule.steps, 1 + static_cast<int>(std::floor(seconds / step_dt))));
+    }
+
+private:
+    // the targets and gains of policy step k (1 .. steps)
+    void apply(int k)
+    {
+        if (k == last_step) {
+            return;
+        }
+        last_step = k;
+        const float kp_scale = schedule.kp_scale(k), kd_scale = schedule.kd_scale(k);
+        for (size_t motor = 0; motor < motors; ++motor) {
+            auto & cmd = lowcmd->msg_.motor_cmd()[motor];
+            float q = start[motor] + getup_chain::smoothstep(schedule.progress(motor, k)) * (goal[motor] - start[motor]);
+            cmd.q() = locked[motor] ? home_q[motor] : std::clamp(q, low[motor], high[motor]);
+            cmd.kp() = stiffness[motor] * kp_scale;
+            cmd.kd() = damping[motor] * kd_scale;
+        }
+    }
+
+    bool finished()
+    {
+        // with the way back on, the time back_due() just took on this tick, so both see the steps done or not
+        const float seconds = back_on ? tick_seconds
+            : std::chrono::duration<float>(std::chrono::steady_clock::now() - entered_at).count();
+        if (seconds < static_cast<float>(schedule.steps) * step_dt) {
+            return false;
+        }
+        if (!reported) {
+            reported = true;
+            if (back_on) {
+                spdlog::warn("{}: {} policy steps done after {:.3f} s, on to the tracker, pelvis {:.1f} deg from the "
+                             "frame's (sim2sim getupchain patch)", getStateString(), schedule.steps, seconds,
+                             tick_angle * kDegrees);
+            } else {
+                spdlog::warn("{}: {} policy steps done after {:.3f} s, on to the tracker (sim2sim getupchain patch)",
+                             getStateString(), schedule.steps, seconds);
+            }
+        }
+        return true;
+    }
+
+    bool back_due()
+    {
+        // iteration 89: the pelvis gravity from this FSM tick's IMU against the frame's; abort_angle at any moment,
+        // retry_angle once the steps are done. When it holds, the next GetUp entry is a return (counted).
+        float quat[4];
+        uint32_t tick;
+        {
+            std::lock_guard<std::mutex> lock(lowstate->mutex_);
+            const auto & q = lowstate->msg_.imu_state().quaternion();
+            for (int i = 0; i < 4; ++i) {
+                quat[i] = q[i];
+            }
+            tick = lowstate->msg_.tick();
+        }
+        tick_seconds = std::chrono::duration<float>(std::chrono::steady_clock::now() - entered_at).count();
+        float gravity[3];
+        getup_chain::imu_gravity(quat, gravity);
+        tick_angle = getup_chain::angle_between(gravity, frame.gravity.data());
+        const bool done = tick_seconds >= static_cast<float>(schedule.steps) * step_dt;
+        const char * why = getup_chain::back_reason(tick_angle, done, retry_angle, abort_angle);
+        if (why == nullptr) {
+            return false;
+        }
+        ++getup_chain::returns.count;
+        getup_chain::returns.pending = true;
+        spdlog::warn("{}: pelvis {:.1f} deg from frame {}'s at policy step {} of {} > {} {:.1f} deg, back to {} "
+                     "(return {}, lowstate tick {}) (sim2sim getupchain patch)", getStateString(),
+                     tick_angle * kDegrees, frame.frame, last_step, schedule.steps, why,
+                     (why[0] == 'a' ? abort_angle : retry_angle) * kDegrees, back_name, getup_chain::returns.count,
+                     tick);
+        return true;
+    }
+
+    bool too_fast()
+    {
+        // each motor on the lowstate of this FSM tick against its own limit; the one furthest past its limit is logged
+        float worst = 1.0f;
+        float fastest = 0.0f;
+        int motor = -1;
+        uint32_t tick;
+        {
+            std::lock_guard<std::mutex> lock(lowstate->mutex_);
+            for (size_t i = 0; i < motors; ++i) {
+                const float speed = std::fabs(lowstate->msg_.motor_state()[i].dq());
+                if (speed > worst * max_joint_speed[i]) {
+                    worst = speed / max_joint_speed[i];
+                    fastest = speed;
+                    motor = static_cast<int>(i);
+                }
+            }
+            tick = lowstate->msg_.tick();
+        }
+        if (motor < 0) {
+            return false;
+        }
+        spdlog::warn("{}: motor {} at {:.1f} rad/s > {:.1f} rad/s at lowstate tick {}, going to Passive "
+                     "(sim2sim getupchain patch)", getStateString(), motor, fastest, max_joint_speed[motor], tick);
+        return true;
+    }
+
+    int next_state = 0;
+    size_t motors = 0;
+    float step_dt = 0.02f;
+    getup_chain::Frame frame;
+    getup_chain::Schedule schedule;
+    std::vector<float> stiffness, damping, low, high, goal, home_q, start, max_joint_speed;
+    std::vector<bool> locked;
+    std::chrono::steady_clock::time_point entered_at;
+    int last_step = 0;
+    bool reported = false;
+    // iteration 89: the way back to the handing state (back_name, back_state), its angles (rad, -1: off), and the time
+    // and pelvis angle back_due() took on the latest FSM tick
+    static constexpr float kDegrees = 57.2957795f;
+    bool back_on = false;
+    int back_state = 0;
+    std::string back_name;
+    float retry_angle = -1.0f, abort_angle = -1.0f;
+    float tick_seconds = 0.0f, tick_angle = 0.0f;
+};
+
+REGISTER_FSM(State_GetUpBlend)
