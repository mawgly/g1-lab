+bool State_RLBase::handover_due()
+{
+    // sim2sim getupchain patch: getup_chain.py's rule on the state the policy is about to act on (its observation's
+    // newest frame: the pelvis IMU's projected gravity and the joint angles), after `step` policy steps of this entry
+    if (!handover_on || handover_blocked) {
+        return false;
+    }
+    const long step = env->episode_length;
+    if (step < 1) {
+        return false;
+    }
+    if (step > handover_steps) {
+        if (!handover_missed) {
+            handover_missed = true;
+            spdlog::warn("{}: no hand-over to {} within {} policy steps, the policy goes on (sim2sim getupchain "
+                         "patch)", getStateString(), handover_to, handover_steps);
+        }
+        return false;
+    }
+    env->robot->update();
+    const auto & data = env->robot->data;
+    const float gravity[3] = {data.projected_gravity_b[0], data.projected_gravity_b[1], data.projected_gravity_b[2]};
+    const float angle = getup_chain::angle_between(gravity, handover_frame.gravity.data());
+    std::vector<float> q(handover_frame.joints.size(), 0.0f);  // SDK order
+    for (size_t i = 0; i < data.joint_ids_map.size(); ++i) {
+        q[static_cast<size_t>(data.joint_ids_map[i])] = data.joint_pos[i];
+    }
+    float deviation = 0.0f;
+    for (int motor : handover_frame.free) {
+        deviation += std::fabs(q[motor] - handover_frame.joints[motor]);
+    }
+    deviation /= static_cast<float>(handover_frame.free.size());
+    const std::string fired = handover_rule.step(step, angle, deviation);
+    if (fired.empty()) {
+        return false;
+    }
+    spdlog::warn("{}: hand-over to {} at policy step {} ({}), angle {:.1f} deg, deviation {:.3f} rad, face down "
+                 "since policy step {} (sim2sim getupchain patch)", getStateString(), handover_to, step, fired,
+                 angle * kRadToDeg, deviation, handover_rule.faced_at);
+    return true;
+}
+
+void State_RLBase::legs_enter()
+{
+    // sim2sim getupchain patch, iteration 91: lowstate's angles on entry (SDK order); with both hips above
+    // legs_home_hip the phase starts from them, its first policy step's targets at once
+    std::vector<float> q(legs_home.home.size(), 0.0f);
+    uint32_t tick;
+    {
+        std::lock_guard<std::mutex> lock(lowstate->mutex_);
+        for (size_t motor = 0; motor < q.size(); ++motor) {
+            q[motor] = lowstate->msg_.motor_state()[motor].q();
+        }
+        tick = lowstate->msg_.tick();
+    }
+    if (!legs_home.due(q)) {
+        return;
+    }
+    legs_home.enter(q);
+    legs_at = std::chrono::steady_clock::now();
+    legs_step = 0;
+    legs_active = true;
+    spdlog::warn("{}: legs home at policy step 1 of {}, hip pitch {:.2f} / {:.2f} rad > {:.2f} rad, lowstate tick {} "
+                 "(sim2sim getupchain patch)", getStateString(), legs_home.schedule.steps,
+                 q[getup_chain::LegsHome::kHips[0]], q[getup_chain::LegsHome::kHips[1]], legs_home.hip, tick);
+    legs_run();
+}
+
+void State_RLBase::legs_run()
+{
+    // sim2sim getupchain patch, iteration 91: the policy step of the time since the phase's start, as GetUpBlend's
+    // run(): min(steps, 1 + floor(t / step_dt)), its targets written once; after the last step's step_dt the phase ends
+    const int steps = legs_home.schedule.steps;
+    const float seconds = std::chrono::duration<float>(std::chrono::steady_clock::now() - legs_at).count();
+    if (seconds < static_cast<float>(steps) * env->step_dt) {
+        const int k = std::min(steps, 1 + static_cast<int>(std::floor(seconds / env->step_dt)));
+        if (k != legs_step) {
+            legs_step = k;
+            for (size_t motor = 0; motor < legs_home.home.size(); ++motor) {
+                lowcmd->msg_.motor_cmd()[motor].q() = legs_home.target(motor, k);
+            }
+        }
+        return;
+    }
+    float hips[2];
+    uint32_t tick;
+    {
+        std::lock_guard<std::mutex> lock(lowstate->mutex_);
+        for (int i = 0; i < 2; ++i) {
+            hips[i] = lowstate->msg_.motor_state()[getup_chain::LegsHome::kHips[i]].q();
+        }
+        tick = lowstate->msg_.tick();
+    }
+    spdlog::warn("{}: legs home done after policy step {} of {} ({:.3f} s), hip pitch {:.2f} / {:.2f} rad, lowstate "
+                 "tick {}, the policy starts (sim2sim getupchain patch)", getStateString(), legs_step, steps, seconds,
+                 hips[0], hips[1], tick);
+    entered_at = std::chrono::steady_clock::now();  // the state's timeout counts the policy's time, as without it
+    legs_active = false;
 }
