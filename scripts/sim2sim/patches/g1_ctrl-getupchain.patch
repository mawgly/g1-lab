diff --git a/deploy/include/FSM/getup_chain.h b/deploy/include/FSM/getup_chain.h
new file mode 100644
index 0000000..e97a857
--- /dev/null
+++ b/deploy/include/FSM/getup_chain.h
@@ -0,0 +1,247 @@
+// sim2sim getupchain patch (humanoid_sim iteration 82, scripts/lab/probes/getup_chain.py): getting up from the back as
+// a chain of two policies. The getting-up policy (GetUp) runs until the hand-over rule holds, then the PD alone takes
+// its last target to the tracker's hand-over frame (GetUpBlend), then the tracker of a human clip (GetUpTrack) runs
+// from that frame. Here the parts both states share, each the number for number port of getup_chain.py's:
+// smoothstep (getup_roll_clip.smoothstep), the hand-over frame of the tracker's export (export_g1 --handover-frame:
+// params/handover.yaml) and the rule (getup_chain.HandOver, the pelvis rule), and since iteration 89 the way back from
+// GetUpBlend to GetUp (getup_chain.Retry: the pelvis IMU's gravity against the frame's, the returns counted), since
+// iteration 91 GetUp's legs-home phase before its policy (getup_chain.legs_home_phase).
+// scripts/sim2sim/chain_model.py is the same in Python (tests/test_getup_chain_patch.py checks it against
+// getup_chain.py; getup_report.py replays it).
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <filesystem>
+#include <limits>
+#include <stdexcept>
+#include <string>
+#include <vector>
+#include <yaml-cpp/yaml.h>
+
+namespace getup_chain
+{
+
+// The quintic smoothstep of x clipped to [0, 1]: 0 -> 1 with zero velocity and acceleration at both ends.
+inline float smoothstep(float x)
+{
+    x = std::clamp(x, 0.0f, 1.0f);
+    return x * x * x * (10.0f - 15.0f * x + 6.0f * x * x);
+}
+
+// The tracker's hand-over frame, from params/handover.yaml of its policy_dir (export_g1 --handover-frame); SDK motor
+// order (joint_ids_map of the G1 29-DoF exports is the identity, the file says it in SDK order either way).
+struct Frame
+{
+    int frame = 0;
+    float seconds = 0.0f;  // from the frame to the clip's end plus its hold: the tracker's training episode left
+    std::vector<float> gravity;  // the pelvis projected gravity at the frame (3)
+    std::vector<float> joints;  // the frame's joint angles, one per SDK motor
+    std::vector<int> free;  // SDK motors the rule's mean |q - q0| covers (all but the locked wrists)
+    std::vector<int> locked;  // SDK motors the policies hold at default_joint_pos (lock_wrists)
+};
+
+inline Frame load_frame(const std::filesystem::path & policy_dir)
+{
+    const auto path = policy_dir / "params" / "handover.yaml";
+    if (!std::filesystem::exists(path)) {
+        throw std::runtime_error("no " + path.string() + ": a tracker export's hand-over frame, written by "
+                                 "humanoid_sim.export_g1 --handover-frame (sim2sim getupchain patch)");
+    }
+    auto node = YAML::LoadFile(path.string());
+    Frame f;
+    f.frame = node["frame"].as<int>();
+    f.seconds = node["seconds"].as<float>();
+    f.gravity = node["gravity"].as<std::vector<float>>();
+    f.joints = node["joints"].as<std::vector<float>>();
+    f.free = node["free"].as<std::vector<int>>();
+    f.locked = node["locked"].as<std::vector<int>>(std::vector<int>{});
+    if (f.gravity.size() != 3 || f.free.empty() || !(f.seconds > 0.0f)) {
+        throw std::runtime_error(path.string() + ": gravity needs 3 numbers, free a motor, seconds above 0 "
+                                 "(sim2sim getupchain patch)");
+    }
+    for (int motor : f.free) {
+        if (motor < 0 || motor >= static_cast<int>(f.joints.size())) {
+            throw std::runtime_error(path.string() + ": free motor " + std::to_string(motor) + " has no joint angle "
+                                     "(sim2sim getupchain patch)");
+        }
+    }
+    return f;
+}
+
+// The angle (rad) between two gravity directions, atan2(|a x b|, a . b) as g1_tensor_math.settle_errors.
+inline float angle_between(const float a[3], const float b[3])
+{
+    const float cx = a[1] * b[2] - a[2] * b[1];
+    const float cy = a[2] * b[0] - a[0] * b[2];
+    const float cz = a[0] * b[1] - a[1] * b[0];
+    return std::atan2(std::sqrt(cx * cx + cy * cy + cz * cz), a[0] * b[0] + a[1] * b[1] + a[2] * b[2]);
+}
+
+// The pelvis IMU's projected gravity from its quaternion (w, x, y, z): R^T (0, 0, -1), what State_RLBase::fell_over
+// gets from Eigen's quat.conjugate() * (0, 0, -1) for a unit quaternion (angle_between does not mind its length).
+inline void imu_gravity(const float q[4], float g[3])
+{
+    const float w = q[0], x = q[1], y = q[2], z = q[3];
+    g[0] = 2.0f * (w * y - x * z);
+    g[1] = -2.0f * (w * x + y * z);
+    g[2] = -(w * w - x * x - y * y + z * z);
+}
+
+// GetUpBlend's returns to GetUp (iteration 89; config.yaml handover: retry_angle, abort_angle, max_retries): how many
+// came since GetUp was last entered from another state, and whether the next GetUp entry is one of them. Both states
+// read and write it on the FSM thread only (their checks and enter()).
+struct Returns
+{
+    int count = 0;
+    bool pending = false;
+};
+inline Returns returns;
+
+// GetUpBlend's way back (getup_chain.Retry), from the pelvis angle (rad) to the frame's gravity: "abort_angle" when it
+// is above abort_angle (any moment), "retry_angle" when the steps are done and it is above retry_angle, else nullptr;
+// an angle limit <= 0 is off.
+inline const char * back_reason(float angle, bool done, float retry_angle, float abort_angle)
+{
+    if (abort_angle > 0.0f && angle > abort_angle) {
+        return "abort_angle";
+    }
+    if (done && retry_angle > 0.0f && angle > retry_angle) {
+        return "retry_angle";
+    }
+    return nullptr;
+}
+
+// getup_chain.HandOver (the pelvis rule): one call per policy step with the policy steps made so far, the observed
+// angle (rad) to the frame's pelvis gravity and the mean |q - q0| (rad) over its free joints. Face down: the angle
+// within face_angle. From then the score angle / angle_scale + deviation / pose_scale is followed, and the hand-over
+// comes at the first step where it is at most good_score ("good"), the pelvis left face down ("left"), the score has
+// risen pass_margin above its least since face down ("least"), or face_seconds after face down ("timeout").
+// Returns the rule that fired, or "" for none. With left_reset (config.yaml handover left: reset, iteration 89) the
+// pelvis leaving face down hands nothing over: the rule starts afresh (not face down, no least) and goes on.
+struct Rule
+{
+    float dt = 0.02f;
+    float face_angle = 0.7853982f;
+    float angle_scale = 0.4363323f;
+    float pose_scale = 0.3f;
+    float pass_margin = 0.3f;
+    float good_score = 2.0f;
+    float face_seconds = 1.0f;
+    bool left_reset = false;
+    long faced_at = -1;
+    float least = std::numeric_limits<float>::infinity();
+
+    void reset()
+    {
+        faced_at = -1;
+        least = std::numeric_limits<float>::infinity();
+    }
+
+    std::string step(long step, float angle, float deviation)
+    {
+        const float value = angle / angle_scale + deviation / pose_scale;
+        if (faced_at < 0) {
+            if (angle > face_angle) {
+                return "";
+            }
+            faced_at = step;
+        }
+        if (value <= good_score) {
+            return "good";
+        }
+        if (angle > face_angle) {
+            if (left_reset) {
+                reset();
+                return "";
+            }
+            return "left";
+        }
+        if (value >= least + pass_margin) {
+            return "least";
+        }
+        if (static_cast<float>(step - faced_at) * dt >= face_seconds - 1e-6f) {
+            return "timeout";
+        }
+        least = std::min(least, value);
+        return "";
+    }
+};
+
+// The PD transition's schedule (getup_chain.pd_schedule): over `steps` policy steps each motor's target goes from the
+// last target to the frame's by the smoothstep of its progress clip((k - late) / max(share * steps - late, 1), 0, 1),
+// share the arms' or the others' part of the steps, late the steps the others start later; the gains are the policy's
+// times kp (kd) going to kp_to (kd_to) by the smoothstep of k / steps. k = 1 .. steps, one per policy step.
+struct Schedule
+{
+    int steps = 1;
+    std::vector<float> share;  // per SDK motor
+    std::vector<float> late;  // per SDK motor, policy steps
+    float kp = 1.0f, kd = 1.0f, kp_to = 1.0f, kd_to = 1.0f;
+
+    float progress(size_t motor, int k) const
+    {
+        const float span = std::max(share[motor] * static_cast<float>(steps) - late[motor], 1.0f);
+        return std::clamp((static_cast<float>(k) - late[motor]) / span, 0.0f, 1.0f);
+    }
+
+    float kp_scale(int k) const
+    {
+        return kp + (kp_to - kp) * smoothstep(static_cast<float>(k) / static_cast<float>(steps));
+    }
+
+    float kd_scale(int k) const
+    {
+        return kd + (kd_to - kd) * smoothstep(static_cast<float>(k) / static_cast<float>(steps));
+    }
+};
+
+// GetUp's legs-home phase (iteration 91; config.yaml handover legs_home_hip, legs_home_seconds; getup_chain.py
+// --legs-home): on a GetUp entry that is not GetUpBlend's return (so from Passive), with both hip pitch angles from
+// lowstate above `hip` (rad), the PD alone for `steps` policy steps before the policy: the legs (SDK motors 0-11) by
+// the quintic over kRamp of the steps from their angle on entry to default_joint_pos, the waist and the arms held at
+// their angle on entry, the locked motors at default_joint_pos, every target clipped as GetUp's deploy.yaml clips its
+// actions; the gains are GetUp's own. Why (the critic's it91): in the Unitree bridge 6 of the 7 runs where 1164 got up
+// alone instead of handing over started on the back after a forward push with both hips flexed at +2.64...+2.88 rad
+// (the stop 2.88), a pose its start bank never has (0 of 40 060 rows); in our physics this phase first gives 80 of 80
+// chains from such poses against 39.
+struct LegsHome
+{
+    static constexpr float kRamp = 0.7f;  // getup_chain.PD_DEFAULTS ramp
+    static constexpr int kLegs = 12;  // SDK motors 0-11: hip pitch, roll, yaw, knee, ankle pitch, roll (left, right)
+    static constexpr int kHips[2] = {0, 6};  // SDK motors of the left and the right hip pitch
+    bool on = false;
+    float hip = 2.0f;
+    float seconds = 1.0f;
+    Schedule schedule;  // share kRamp for every motor, late 0, gains x1 (only its progress is used)
+    std::vector<float> low, high, home, start, goal;  // per SDK motor
+    std::vector<bool> locked;
+
+    // whether lowstate's angles q (SDK order) call for the phase
+    bool due(const std::vector<float> & q) const
+    {
+        return on && q[kHips[0]] > hip && q[kHips[1]] > hip;
+    }
+
+    // the phase from the angles on entry: the legs to home, every other motor held where it is
+    void enter(const std::vector<float> & q)
+    {
+        start = q;
+        goal = q;
+        for (int motor = 0; motor < kLegs; ++motor) {
+            goal[motor] = home[motor];
+        }
+    }
+
+    // motor's target at policy step k (1 .. schedule.steps)
+    float target(size_t motor, int k) const
+    {
+        if (locked[motor]) {
+            return home[motor];
+        }
+        const float q = start[motor] + smoothstep(schedule.progress(motor, k)) * (goal[motor] - start[motor]);
+        return std::clamp(q, low[motor], high[motor]);
+    }
+};
+
+}  // namespace getup_chain
