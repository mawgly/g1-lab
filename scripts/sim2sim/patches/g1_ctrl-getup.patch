+
+bool State_RLBase::timed_out()
+{
+    // sim2sim getup patch: the time since enter() against config.yaml's timeout of this state
+    float seconds = std::chrono::duration<float>(std::chrono::steady_clock::now() - entered_at).count();
+    if (seconds <= timeout) {
+        return false;
+    }
+    spdlog::warn("{}: {:.2f} s in the state > {:.1f} s, going to Passive (sim2sim getup patch)", getStateString(),
+                 seconds, timeout);
+    return true;
+}
+
+bool State_RLBase::too_fast()
+{
+    // sim2sim getup patch: each of the policy's joints on the lowstate of this FSM tick against its own limit,
+    // config.yaml's max_joint_speed of this state by SDK motor; the one furthest past its limit is logged
+    float worst = 1.0f;  // speed / limit of the motor logged
+    float fastest = 0.0f;
+    int motor = -1;
+    uint32_t tick;
+    {
+        std::lock_guard<std::mutex> lock(lowstate->mutex_);
+        for (size_t i = 0; i < env->robot->data.joint_ids_map.size(); i++) {
+            int index = static_cast<int>(env->robot->data.joint_ids_map[i]);
+            float speed = std::fabs(lowstate->msg_.motor_state()[index].dq());
+            if (speed > worst * max_joint_speed[index]) {
+                worst = speed / max_joint_speed[index];
+                fastest = speed;
+                motor = index;
+            }
+        }
+        tick = lowstate->msg_.tick();
+    }
+    if (motor < 0) {
+        return false;
+    }
+    spdlog::warn("{}: motor {} at {:.1f} rad/s > {:.1f} rad/s at lowstate tick {}, going to Passive "
+                 "(sim2sim getup patch)", getStateString(), motor, fastest, max_joint_speed[motor], tick);
+    return true;
 }
