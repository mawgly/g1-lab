+bool State_RLBase::fell_over(float limit_angle)
+{
+    // sim2sim patch: bad_orientation's test, acos(-g_z) > limit with g the gravity in the pelvis IMU frame as
+    // BaseArticulation::update computes it, but on the lowstate of this FSM tick: env's projected_gravity_b is
+    // refreshed only by the policy thread, once a policy step.
+    Eigen::Quaternionf quat;
+    uint32_t tick;
+    {
+        std::lock_guard<std::mutex> lock(lowstate->mutex_);
+        const auto & q = lowstate->msg_.imu_state().quaternion();
+        quat = Eigen::Quaternionf(q[0], q[1], q[2], q[3]);
+        tick = lowstate->msg_.tick();
+    }
+    Eigen::Vector3f gravity = quat.conjugate() * Eigen::Vector3f(0.0f, 0.0f, -1.0f);
+    float tilt = std::acos(std::clamp(-gravity[2], -1.0f, 1.0f));
+    if (tilt <= limit_angle) {
+        return false;
+    }
+    spdlog::warn("{}: pelvis tilt {:.1f} deg > {:.1f} deg at lowstate tick {}, going to Passive "
+                 "(sim2sim fall-passive patch)", getStateString(), tilt * kRadToDeg, limit_angle * kRadToDeg, tick);
+    return true;
 }
